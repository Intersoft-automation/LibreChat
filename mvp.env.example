# LibreChat
HOST=localhost
PORT=3080
APP_TITLE=Intersoft Chat
UID=1000
GID=1000
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
ADMIN_PANEL_PORT=3090
ADMIN_PANEL_SESSION_SECRET=__GENERATE_ADMIN_PANEL_SECRET__
ADMIN_PANEL_SESSION_COOKIE_SECURE=false

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ENDPOINTS=custom,agents

JWT_SECRET=__GENERATE_JWT_SECRET__
JWT_REFRESH_SECRET=__GENERATE_JWT_REFRESH_SECRET__
CREDS_KEY=__GENERATE_CREDS_KEY__
CREDS_IV=__GENERATE_CREDS_IV__

SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_MASTER_KEY=__GENERATE_MEILI_MASTER_KEY__

# Credential accepted by the standalone LLMGateway.
# The MVP temporarily uses its master key; replace it with a dedicated
# LibreChat virtual key after the gateway database is enabled.
LITELLM_MASTER_KEY=REPLACE_WITH_GATEWAY_CLIENT_KEY

# RAG is bundled by the upstream compose but intentionally not enabled in the
# first MVP UI. Configure an embeddings endpoint in the next slice.
RAG_OPENAI_API_KEY=
